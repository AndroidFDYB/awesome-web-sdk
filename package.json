{
  "name": "mp-sdk",
  "version": "1.0.0",
  "description": "跨平台 JSBridge SDK 工程",
  "private": true,
  "scripts": {
    "build:proto": "cd specs/proto-codegen && npm run build",
    "codegen:harmony": "node scripts/proto-codegen-harmony.js",
    "scan:harmony": "node scripts/scan-decorators-harmony.js",
    "codegen:ios": "node scripts/proto-codegen-ios.js",
    "codegen:flutter": "node scripts/proto-codegen-flutter.js",
    "build:android": "node scripts/build-android.js",
    "build:harmony": "node scripts/build-harmony.js && node scripts/post-build.js harmony",
    "build:web": "cd vue-web-sdk && npm run build && npm pack && cd .. && node scripts/post-build.js web",
    "build:ios": "node scripts/build-ios.js && node scripts/post-build.js ios",
    "build:flutter": "node scripts/build-flutter.js",
    "build:all": "npm run build:android && npm run build:harmony && npm run build:web && npm run build:ios",
    "install:web-sdk": "cd vue-web-sdk && npm install",
    "install:vue-web": "cd vue-web && npm install",
    "install:all": "npm run install:web-sdk && npm run install:vue-web"
  },
  "devDependencies": {
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@mp-sdk/proto-codegen": "file:specs/proto-codegen"
  }
}
